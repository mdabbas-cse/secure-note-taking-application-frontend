# Base URL of the backend API, including the /api prefix. No trailing slash.
# Required for production builds (set it in the Vercel project settings).
# Local development leaves it unset: the Vite dev server proxies /api to http://localhost:4000.
VITE_API_BASE_URL=https://your-backend-domain.vercel.app/api

# Only VITE_* variables reach the browser bundle. Never put secrets here.
